# Identifiant local non sensible. La valeur par defaut est "admin".
KEYCLOAK_ADMIN_USERNAME=admin

# Remplacer cette valeur dans .env. Ne jamais versionner le mot de passe reel.
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only

# Base PostgreSQL locale du service utilisateur.
USER_DB_PASSWORD=change-me-local-only
